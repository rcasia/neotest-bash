#!/bin/bash
# Run tests with mini.test (bootstrap: scripts/minimal_init.lua).
# mini.test's stdout reporter makes Neovim exit nonzero when any case fails
# or errors, so no output scraping is needed.

NVIM=${NVIM:-nvim}
INIT=${INIT:-scripts/minimal_init.lua}

if [[ -n $1 ]] && [[ $1 == "--fail-fast" ]]; then
  echo "Running tests with --fail-fast"
  "$NVIM" --headless --noplugin -u "$INIT" \
    -c "lua require('mini.test').run({ execute = { stop_on_error = true } })"
elif [[ -n $1 ]]; then
  echo "Running single test file: $1"
  "$NVIM" --headless --noplugin -u "$INIT" \
    -c "lua require('mini.test').run({ collect = { find_files = function() return { '$1' } end } })"
else
  "$NVIM" --headless --noplugin -u "$INIT" \
    -c "lua require('mini.test').run()"
fi
