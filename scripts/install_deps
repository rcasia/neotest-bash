#!/usr/bin/env bash
# Clone pinned test dependencies into ./dependencies/ (gitignored).
# Replaces the previous git submodule setup so local runs and CI resolve
# identical revisions without submodule state in the repo.
set -euo pipefail

cd "$(dirname "$0")/.."

clone_dep() {
  local name="$1" url="$2" rev="$3"
  git clone --quiet "$url" "dependencies/${name}"
  git -C "dependencies/${name}" checkout --quiet --detach "$rev"
  echo "Installed ${name} @ $(git -C "dependencies/${name}" describe --tags --always)"
}

mkdir -p dependencies

# Pinned by full commit sha so CI and local runs resolve identically.
clone_dep neotest https://github.com/nvim-neotest/neotest 1c529a1ef9c82e8131e872368415cecc2bb86ea2 # v5.20.0
clone_dep nvim-nio https://github.com/nvim-neotest/nvim-nio 21f5324bfac14e22ba26553caf69ec76ae8a7662 # v1.10.1
clone_dep mini.nvim https://github.com/echasnovski/mini.nvim ee23d71c02440668cbca5b0cd8640d79d5bc250b # main 2026-09-05; only mini.test is used
# plenary is NOT a direct dependency anymore (neotest dropped it as a runtime
# dep in nvim-neotest/neotest#612 and our code never used it). It is kept only
# because neotest v5.20 still requires plenary.path/plenary.filetype in
# neotest.lib.file/lib.positions/lib.subprocess, so it must be on the
# runtimepath — same rationale as rcasia/neotest-java#317. Its plugin/ is
# deliberately never sourced, so luassert's global assert is not installed.
clone_dep plenary.nvim https://github.com/nvim-lua/plenary.nvim b9fd5226c2f76c951fc8ed5923d85e4de065e509 # v0.1.4-38
clone_dep nvim-treesitter https://github.com/nvim-treesitter/nvim-treesitter 20fc6b1270dddff7e16220e0a51d17614d41fd43
